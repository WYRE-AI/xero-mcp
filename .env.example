# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load this file. Do not add
# XERO_ACCESS_TOKEN or XERO_TENANT_ID to that service's environment.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A known placeholder is still refused when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Defaults to 0.0.0.0.
# Without a secret, MCP_ALLOW_INSECURE_DEV=1 forces 127.0.0.1.
# The container image sets 0.0.0.0.
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080

# Credential source for HTTP: env (process environment) or gateway (required
# X-Xero-Access-Token and X-Xero-Tenant-Id headers; no env fallback).
# Compose sets gateway. Stdio ignores this and reads XERO_* from the environment.
# AUTH_MODE=env
